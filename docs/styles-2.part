ute; right:3vw; top:17%; width:min(37vw,560px); aspect-ratio:1; z-index:-1; opacity:.86; transform:rotate(-8deg); }
.orbit-ring { position:absolute; border:1px solid var(--line); border-radius:50%; inset:0; }
.orbit-2 { inset:15%; border-style:dashed; animation:spin 34s linear infinite; }
.orbit-3 { inset:32%; }
@keyframes spin{to{transform:rotate(360deg)}}
.orbit-node { position:absolute; width:10px; height:10px; border-radius:50%; background:var(--accent); box-shadow:0 0 0 7px var(--accent-soft); }
.node-a{top:19%;left:13%}.node-b{top:71%;left:78%;background:var(--ink);box-shadow:0 0 0 7px var(--line)}.node-c{top:43%;left:83%;width:6px;height:6px}
.orbit-label{position:absolute;font-family:Georgia,serif;font-style:italic;font-size:12px;color:var(--muted)}.label-a{top:13%;left:16%}.label-b{top:75%;left:62%}.label-c{top:39%;left:87%}

.studio-section,.dashboard-section,.principles-section { position:relative; padding:150px 0 160px; border-bottom:1px solid var(--line); }
.studio-head,.dashboard-head { display:grid; grid-template-columns:1.4fr .6fr; gap:50px; align-items:end; margin-bottom:70px; }
h2 { margin:0; font-size:clamp(42px,5.1vw,82px); letter-spacing:-.06em; line-height:.96; font-weight:650; }
.mode-chip { justify-self:end; display:inline-flex; align-items:center; gap:9px; border:1px solid var(--line); border-radius:999px; padding:10px 13px; font-size:10px; color:var(--muted); }
.mode-dot { width:6px;height:6px;border-radius:50%;background:var(--green); }
.composer { background:var(--panel); border:1px solid var(--line); border-radius:var(--radius); overflow:hidden; box-shadow:var(--shadow); backdrop-filter:blur(18px); }
.composer-main{padding:34px 34px 26px}.composer-main>label,.field-group>label{display:block;font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:14px}
.url-row{display:grid;grid-template-columns:1fr auto;gap:14px;align-items:center}
.url-row input{border:0;background:transparent;font-size:clamp(22px,3vw,48px);font-weight:520;letter-spacing:-.04em;outline:none;min-width:0;padding:7px 0;color:var(--ink)}
.url-row input::placeholder{color:color-mix(in srgb,var(--muted) 58%,transparent)}
.primary-btn { border:0; background:var(--ink); color:var(--bg); border-radius:999px; min-width:138px; height:52px; padding:0 20px; display:flex; align-items:center; justify-content:space-between; gap:22px; font-size:12px; transition:transform .22s var(--ease),box-shadow .22s; box-shadow:0 8px 22px rgba(0,0,0,.08); }
.primary-btn:hover{box-shadow:0 12px 28px rgba(0,0,0,.14)}.primary-btn:disabled{opacity:.45;cursor:not-allowed;transform:none!important}
.input-meta{display:flex;justify-content:space-between;gap:20px;border-top:1px solid var(--line);margin-top:24px;padding-top:16px;font-size:10px;color:var(--muted)}
.input-meta .valid{color:var(--green)}.input-meta .invalid{color:var(--accent)}
.advanced-toggle{width:100%;border:0;border-top:1px solid var(--line);background:transparent;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:18px;padding:17px 34px;font-size:11px;color:var(--muted);text-align:left}
.toggle-line{height:1px;background:var(--line)}#advanced-symbol{font-size:18px;line-height:1;transition:transform .25s var(--ease)}.advanced-toggle[aria-expanded="true"] #advanced-symbol{transform:rotate(45deg)}
.advanced-panel{border-top:1px solid var(--line);padding:29px 34px 34px;display:grid;grid-template-columns:1.25fr 1.2fr .75fr .75fr;gap:26px;animation:reveal .28s var(--ease)}
.advanced-panel[hidden]{display:none}@keyframes reveal{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:none}}
.field-group input,.field-group select,.prefix-field{width:100%;border:1px solid var(--line);background:rgba(255,255,255,.03);border-radius:12px;min-height:45px;outline:none;transition:border-color .2s,background .2s}.field-group input,.field-group select{padding:0 13px}.field-group input:focus,.field-group select:focus,.prefix-field:focus-within{border-color:var(--line-strong);background:var(--panel-solid)}
.field-group small{display:block;margin-top:8px;font-size:9px;line-height:1.4;color:var(--muted)}.prefix-field{display:flex;align-items:center;overflow:hidden}.prefix-field span{padding-left:13px;color:var(--muted);font-size:12px;white-space:nowrap}.prefix-field input{border:0!important;background:transparent!important;border-radius:0;padding-left:0;font-weight:600}
.switch-group{display:flex;align-items:center;justify-content:space-between;gap:12px}.switch-group label{margin:0}.switch{position:relative;width:42px;height:24px;flex:0 0 auto}.switch input{position:absolute;opacity:0}.switch span{position:absolute;inset:0;border-radius:99px;background:var(--line-strong);transition:background .2s}.switch span::after{content:"";position:absolute;width:18px;height:18px;border-radius:50%;left:3px;top:3px;background:var(--panel-solid);box-shadow:0 1px 4px rgba(0,0,0,.15);transition:transform .25s var(--ease)}.switch input:checked+span{background:var(--accent)}.switch input:checked+span::after{transform:translateX(18px)}
.utm-field{grid-column:1/-1}.utm-field[hidden]{display:none}.turnstile-wrap{border-top:1px solid var(--line);padding:18px 34px;display:flex;align-items:center;justify-content:space-between;gap:16px}.turnstile-wrap[hidden]{display:none}.turnstile-wrap small{font-size:9px;color:var(--muted)}
.result-card{margin-top:18px;border:1px solid var(--line);background:var(--ink);color:var(--bg);border-radius:var(--radius);padding:28px 30px;animation:resultIn .5s var(--ease);box-shadow:var(--shadow)}.result-card[hidden]{display:none}@keyframes resultIn{from{opacity:0;transform:translateY(12px) scale(.985)}to{opacity:1;transform:none}}
.result-kicker{font-size:9px;letter-spacing:.14em;text-transform:uppercase;opacity:.55;margin-bottom:28px}.result-link-wrap{display:flex;align-items:center;gap:15px}.result-link-wrap a{font-size:clamp(30px,4.5vw,70px);letter-spacing:-.055em;font-weight:650;text-decoration:none;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.copy-btn{margin-left:auto;border:1px solid rgba(255,255,255,.18);background:transparent;color:inherit;border-radius:999px;padding:10px 16px;font-size:11px}.copy-btn:hover{background:rgba(255,255,255,.08)}.result-destination{font-size:11px;opacity:.5;margin-top:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.result-actions{display:flex;gap:20px;margin-top:31px}.result-actions button{border:0;background:transparent;color:inherit;padding:0 0 5px;border-bottom:1px solid rgba(255,255,255,.25);font-size:10px;opacity:.7}

.dashboard-controls{justify-self:end;display:flex;gap:8px}.metrics-grid{display:grid;grid-template-columns:1.5fr .8fr .9fr .8fr;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;background:var(--panel);backdrop-filter:blur(16px);box-shadow:var(--shadow)}.metric-card{min-height:270px;padding:27px;position:relative;border-right:1px solid var(--line);overflow:hidden}.metric-card:last-child{