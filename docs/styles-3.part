border-right:0}.metric-card>span{font-size:10px;text-transform:uppercase;letter-spacing:.13em;color:var(--muted)}.metric-card strong{display:block;font-size:clamp(38px,4vw,66px);letter-spacing:-.06em;margin-top:24px;font-weight:630}.metric-card small{display:block;color:var(--muted);font-size:10px;margin-top:7px}.sparkline{position:absolute;left:0;right:0;bottom:0;width:100%;height:96px}.sparkline path.area{fill:var(--accent-soft)}.sparkline path.line{fill:none;stroke:var(--accent);stroke-width:2;vector-effect:non-scaling-stroke}.mini-track{position:absolute;left:27px;right:27px;bottom:31px;height:3px;background:var(--line);overflow:hidden;border-radius:3px}.mini-track i{display:block;height:100%;width:0;background:var(--ink);transition:width .7s var(--ease)}.device-bars{position:absolute;left:27px;right:27px;bottom:28px;display:grid;gap:7px}.device-bar{display:grid;grid-template-columns:56px 1fr 30px;gap:8px;align-items:center;font-size:9px;color:var(--muted)}.device-bar i{height:3px;background:var(--line);position:relative}.device-bar i::after{content:"";position:absolute;inset:0 auto 0 0;width:var(--pct);background:var(--ink)}.pulse-dots{position:absolute;left:27px;right:27px;bottom:29px;display:flex;gap:7px;flex-wrap:wrap}.pulse-dots i{width:7px;height:7px;border-radius:50%;background:var(--line-strong)}.pulse-dots i.hot{background:var(--accent);box-shadow:0 0 0 4px var(--accent-soft)}
.link-library{margin-top:18px;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;background:var(--panel);backdrop-filter:blur(16px)}.library-toolbar{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:18px 20px;border-bottom:1px solid var(--line)}.search-wrap{display:flex;align-items:center;gap:10px;flex:1}.search-wrap span{color:var(--muted)}.search-wrap input{border:0;outline:0;background:transparent;width:min(500px,100%);font-size:12px}.library-meta{display:flex;align-items:center;gap:11px;font-size:9px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}.sample-badge{border:1px solid var(--line);border-radius:999px;padding:7px 9px}.link-table-head,.link-row{display:grid;grid-template-columns:1.15fr 1.6fr .45fr .55fr 40px;gap:20px;align-items:center}.link-table-head{padding:12px 20px;font-size:9px;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);border-bottom:1px solid var(--line)}.link-row{min-height:92px;padding:16px 20px;border-bottom:1px solid var(--line);transition:background .2s}.link-row:last-child{border-bottom:0}.link-row:hover{background:var(--accent-soft)}.link-primary{min-width:0}.link-slug{font-size:14px;font-weight:650;display:flex;align-items:center;gap:9px}.link-slug .status{width:6px;height:6px;border-radius:50%;background:var(--green);flex:0 0 auto}.link-title{font-size:10px;color:var(--muted);margin-top:7px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.link-destination{font-size:10px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.link-clicks{font-size:20px;letter-spacing:-.04em}.link-date{font-size:10px;color:var(--muted)}.row-menu{border:1px solid var(--line);width:32px;height:32px;border-radius:50%;background:transparent;display:grid;place-items:center;font-size:16px;transition:background .2s,transform .2s}.row-menu:hover{background:var(--panel-solid);transform:rotate(90deg)}.empty-state{text-align:center;padding:74px 20px}.empty-state[hidden]{display:none}.empty-mark{display:flex;justify-content:center;gap:7px}.empty-mark span{width:9px;height:9px;border-radius:50%;border:1px solid var(--muted)}.empty-state h3{font-family:Georgia,serif;font-weight:400;font-style:italic;font-size:26px;margin:20px 0 7px}.empty-state p{color:var(--muted);font-size:11px}

.principles-intro{margin-bottom:70px}.principles-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.principles-grid article{padding:28px 26px 52px 0;border-right:1px solid var(--line);min-height:280px}.principles-grid article+article{padding-left:26px}.principles-grid article:last-child{border-right:0}.principles-grid article>span{font-size:9px;color:var(--muted);letter-spacing:.1em}.principles-grid h3{font-size:17px;font-weight:600;margin:70px 0 14px}.principles-grid p{font-size:11px;line-height:1.7;color:var(--muted);margin:0;max-width:260px}.architecture-strip{margin-top:72px;display:grid;grid-template-columns:1fr auto 1fr auto 1fr;gap:22px;align-items:center}.architecture-strip>div{border:1px solid var(--line);border-radius:16px;padding:20px;display:grid;grid-template-columns:auto 1fr;column-gap:15px}.architecture-strip span{grid-row:1/3;font-size:9px;color:var(--muted)}.architecture-strip strong{font-size:12px}.architecture-strip small{font-size:9px;color:var(--muted);margin-top:4px}.architecture-strip>i{font-style:normal;color:var(--muted)}
.site-footer{padding:70px 0 36px}.footer-brand{font-size:clamp(90px,20vw,320px);font-weight:720;letter-spacing:-.09em;line-height:.74;border-bottom:1px solid var(--line);padding-bottom:28px}.site-footer>p{font-family:Georgia,serif;font-style:italic;font-size:22px;margin:25px 0 50px}.footer-meta{display:flex;justify-content:space-between;font-size:9px;text-transform:uppercase;letter-spacing:.1em;color:var(--muted)}.footer-meta a{text-decoration:none}

.details-dialog,.command-dialog{border:0;padding:0;background:transparent;color:var(--ink);max-width:none;max-height:none}.details-dialog::backdrop,.command-dialog::backdrop{background:rgba(0,0,0,.35);backdrop-filter:blur(9px)}.details-dialog{width:min(720px,calc(100vw - 28px));margin:auto}.dialog-shell{background:var(--panel-solid);border:1px solid var(--line);border-radius:24px;box-shadow:0 30px 100px rgba(0,0,0,.28);padding:28px;position:relative}.dialog-close{position:absolute;right:20px;top:18px;width:36px;height:36px;border-radius:50%;border:1px solid var(--line);background:transparent;font-size:20px}.dialog-kicker{font-size:9px;letter-spacing:.15em;color:var(--muted);margin-bottom:34px}.detail-title{font-size:clamp(36px,6vw,64px);letter-spacing:-.06em;font-weight:650;margin:0 55px 12px 0}.detail-destination{color:var(--muted);font-size:11px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.detail-stats{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin:30px 0}.detail-stat{padding:19px 4px}.detail-stat+ .detail-stat{border-left:1px solid var(--line);padding-left:19px}.detail-stat span{display:block;font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:.1em}.detail-stat strong{display:block;font-size:27px;margin-top:8px}.detail-actions{display:flex;gap:8px;flex-wrap:wrap}.detail-actions button{border:1px solid var(--line);border-radius:999px;background:transparent;padding:10px 13px;font-size:10px}.detail-actions .danger:hover{border-color:var(--accent);color:var(--accent)}
.command-dialog{width:min(620px,calc(100vw - 24px));ma