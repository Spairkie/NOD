rgin:12vh auto auto}.command-shell{background:var(--panel-solid);border:1px solid var(--line);border-radius:18px;box-shadow:0 30px 100px rgba(0,0,0,.3);overflow:hidden}.command-search{display:flex;gap:12px;align-items:center;padding:18px;border-bottom:1px solid var(--line)}.command-search input{border:0;outline:0;background:transparent;flex:1;font-size:15px}.command-list{padding:8px;max-height:360px;overflow:auto}.command-item{width:100%;border:0;background:transparent;border-radius:11px;padding:11px 12px;display:flex;justify-content:space-between;align-items:center;text-align:left;font-size:11px}.command-item:hover,.command-item.active{background:var(--accent-soft)}.command-item small{color:var(--muted)}.command-foot{border-top:1px solid var(--line);padding:10px 13px;display:flex;gap:17px;font-size:9px;color:var(--muted)}.command-foot span{display:flex;gap:4px;align-items:center}
.toast-stack{position:fixed;right:18px;bottom:18px;z-index:80;display:grid;gap:8px}.toast{background:var(--ink);color:var(--bg);border-radius:12px;padding:12px 15px;font-size:10px;box-shadow:var(--shadow);animation:toastIn .3s var(--ease);max-width:310px}.toast.error{background:var(--accent);color:#fff}@keyframes toastIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}

.redirect-screen{position:fixed;inset:0;background:var(--bg);z-index:100;display:grid;place-items:center;text-align:center;padding:30px}.redirect-screen .redirect-mark{display:flex;justify-content:center;gap:8px;margin-bottom:28px}.redirect-screen .redirect-mark span{width:12px;height:12px;border-radius:50%;background:var(--ink);animation:redirect 1s infinite var(--ease)}.redirect-screen .redirect-mark span:nth-child(2){animation-delay:.12s}.redirect-screen .redirect-mark span:nth-child(3){animation-delay:.24s}@keyframes redirect{50%{transform:translateY(-9px);background:var(--accent)}}.redirect-screen h2{font-size:clamp(40px,7vw,90px)}.redirect-screen p{color:var(--muted);font-size:12px;margin-top:20px}

@media (max-width: 1050px){
  .top-nav{display:none}.site-header{grid-template-columns:1fr 1fr}.hero-orbit{right:-10vw;width:56vw;top:22%;opacity:.62}.hero-copy,.text-link{margin-left:25%;}.advanced-panel{grid-template-columns:1fr 1fr}.metrics-grid{grid-template-columns:1fr 1fr}.metric-card{border-bottom:1px solid var(--line)}.metric-card:nth-child(2){border-right:0}.metric-card:nth-child(3),.metric-card:nth-child(4){border-bottom:0}.principles-grid{grid-template-columns:1fr 1fr}.principles-grid article:nth-child(2){border-right:0}.principles-grid article:nth-child(-n+2){border-bottom:1px solid var(--line)}.link-table-head,.link-row{grid-template-columns:1.2fr 1.5fr .4fr 40px}.link-table-head span:nth-child(4),.link-row .link-date{display:none}
}
@media (max-width: 700px){
  :root{--header-h:66px}.noise{display:none}.site-header,main,.site-footer{width:min(calc(100% - 24px),var(--max))}.brand-meta,.shortcut-btn span{display:none}.shortcut-btn{padding:0 11px}.hero{min-height:88svh;padding-top:90px}.hero-index,.section-label{top:19px}.hero h1{font-size:clamp(58px,20vw,95px);line-height:.82}.hero-copy{width:88%;margin:37px 0 17px 0;font-size:15px}.text-link{margin-left:0}.hero-orbit{width:80vw;right:-35vw;top:15%;opacity:.4}.hero-footnote{display:none}.studio-section,.dashboard-section,.principles-section{padding:105px 0}.studio-head,.dashboard-head{grid-template-columns:1fr;gap:25px;margin-bottom:42px}.mode-chip,.dashboard-controls{justify-self:start}.url-row{grid-template-columns:1fr}.url-row input{font-size:23px}.primary-btn{width:100%;height:48px}.composer-main{padding:25px 20px 20px}.advanced-toggle{padding:15px 20px}.advanced-panel{padding:22px 20px;grid-template-columns:1fr}.utm-field{grid-column:auto}.input-meta span:last-child{display:none}.result-card{padding:23px 20px}.result-link-wrap a{font-size:31px}.metrics-grid{grid-template-columns:1fr}.metric-card{min-height:215px;border-right:0!important;border-bottom:1px solid var(--line)!important}.metric-card:last-child{border-bottom:0!important}.library-toolbar{align-items:flex-start;flex-direction:column}.library-meta{width:100%;justify-content:space-between}.link-table-head{display:none}.link-row{grid-template-columns:1fr auto;gap:9px 18px;padding:18px}.link-row .link-destination{grid-column:1/-1}.link-row .link-clicks{grid-column:1}.link-row .row-menu{grid-column:2;grid-row:1}.principles-grid{grid-template-columns:1fr}.principles-grid article{border-right:0!important;border-bottom:1px solid var(--line);padding:25px 0 42px!important;min-height:auto}.principles-grid article:last-child{border-bottom:0}.principles-grid h3{margin-top:40px}.architecture-strip{grid-template-columns:1fr}.architecture-strip>i{transform:rotate(90deg);justify-self:center}.footer-meta{gap:18px;flex-wrap:wrap}.footer-meta a{margin-left:auto}.command-foot{display:none}.detail-stats{grid-template-columns:1fr}.detail-stat+.detail-stat{border-left:0;border-top:1px solid var(--line);padding-left:4px}
}
@media (prefers-reduced-motion: reduce){html{scroll-behavior:auto}*,*::before,*::after{animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important}#flow-field{display:none}}

.studio-section,.dashboard-section,.principles-section{scroll-margin-top:calc(var(--header-h) + 12px)}
