:root {
  --bg: #f2efe7;
  --bg-soft: #e9e5db;
  --panel: rgba(247, 244, 236, 0.76);
  --panel-solid: #f7f4ec;
  --ink: #121310;
  --muted: #69685f;
  --line: rgba(18, 19, 16, 0.15);
  --line-strong: rgba(18, 19, 16, 0.3);
  --accent: #ff5b3a;
  --accent-soft: rgba(255, 91, 58, 0.12);
  --green: #487b5c;
  --shadow: 0 24px 70px rgba(45, 39, 30, 0.09);
  --radius: 22px;
  --radius-sm: 14px;
  --header-h: 78px;
  --max: 1500px;
  --ease: cubic-bezier(.2,.78,.24,1);
}

html[data-theme="dark"] {
  --bg: #11120f;
  --bg-soft: #171813;
  --panel: rgba(25, 26, 21, 0.76);
  --panel-solid: #1a1b16;
  --ink: #f2efe7;
  --muted: #a4a197;
  --line: rgba(242, 239, 231, 0.13);
  --line-strong: rgba(242, 239, 231, 0.28);
  --accent: #ff6b48;
  --accent-soft: rgba(255, 107, 72, 0.13);
  --green: #79a98b;
  --shadow: 0 28px 80px rgba(0,0,0,.28);
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; overflow-x: clip; }
body {
  margin: 0;
  min-width: 320px;
  background: var(--bg);
  color: var(--ink);
  font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
  transition: background .45s var(--ease), color .45s var(--ease);
  overflow-x: clip;
}
button, input, select { font: inherit; color: inherit; }
button { cursor: pointer; }
a { color: inherit; }
::selection { background: var(--accent); color: white; }
button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible { outline: 2px solid var(--accent) !important; outline-offset: 3px; }

#flow-field {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: -2;
  opacity: .42;
  pointer-events: none;
}
.noise {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 40;
  opacity: .045;
  mix-blend-mode: multiply;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.86' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.4'/%3E%3C/svg%3E");
}
html[data-theme="dark"] .noise { opacity: .035; mix-blend-mode: screen; }

.site-header {
  position: sticky;
  top: 0;
  z-index: 30;
  height: var(--header-h);
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  width: min(calc(100% - 40px), var(--max));
  margin: 0 auto;
  border-bottom: 1px solid var(--line);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}
.brand { text-decoration: none; display: inline-flex; align-items: center; gap: 9px; width: max-content; }
.brand-mark { width: 31px; height: 18px; position: relative; display: inline-block; }
.brand-mark i { position: absolute; width: 8px; height: 8px; border-radius: 999px; background: var(--ink); top: 5px; transition: transform .35s var(--ease), background .35s; }
.brand-mark i:nth-child(1){ left:0; }
.brand-mark i:nth-child(2){ left:11px; }
.brand-mark i:nth-child(3){ left:22px; }
.brand:hover .brand-mark i:nth-child(1){ transform: translateY(-3px); }
.brand:hover .brand-mark i:nth-child(3){ transform: translateY(3px); }
.brand-word { font-size: 14px; font-weight: 760; letter-spacing: .12em; }
.brand-meta { font-size: 9px; letter-spacing: .17em; color: var(--muted); padding-left: 4px; }
.top-nav { display: flex; align-items: center; gap: 26px; }
.top-nav a { text-decoration: none; font-size: 12px; color: var(--muted); position: relative; transition: color .2s; }
.top-nav a::after { content:""; position:absolute; height:1px; left:50%; right:50%; bottom:-7px; background:var(--ink); transition:left .25s var(--ease),right .25s var(--ease); }
.top-nav a:hover { color: var(--ink); }
.top-nav a:hover::after { left:0; right:0; }
.header-actions { justify-self: end; display:flex; gap:8px; align-items:center; }
.quiet-btn, .icon-btn {
  border: 1px solid var(--line);
  background: rgba(255,255,255,.03);
  border-radius: 999px;
  min-height: 38px;
  transition: border-color .2s, transform .2s var(--ease), background .2s;
}
.quiet-btn { padding: 0 14px; font-size: 11px; display:flex; align-items:center; gap:10px; }
.quiet-btn:hover,.icon-btn:hover{ border-color:var(--line-strong); transform:translateY(-1px); background:var(--panel); }
.icon-btn { width:38px; display:grid; place-items:center; overflow:hidden; position:relative; }
.icon-btn span { position:absolute; transition: transform .35s var(--ease), opacity .35s; }
html[data-theme="light"] .moon { transform: translateY(22px); opacity:0; }
html[data-theme="dark"] .sun { transform: translateY(-22px); opacity:0; }
kbd { font-family: inherit; font-size:.8em; border:1px solid var(--line); border-bottom-color:var(--line-strong); padding:2px 5px; border-radius:5px; background:var(--panel); color:var(--muted); box-shadow:0 1px 0 var(--line); }

main, .site-footer { width:min(calc(100% - 40px), var(--max)); margin:0 auto; }
.hero {
  min-height: calc(100vh - var(--header-h));
  position: relative;
  display:flex;
  flex-direction:column;
  justify-content:center;
  padding: 11vh 0 9vh;
  border-bottom:1px solid var(--line);
  isolation:isolate;
  overflow: hidden;
}
.hero-index,.section-label { position:absolute; top:28px; left:0; font-size:9px; letter-spacing:.18em; color:var(--muted); }
.eyebrow { margin:0 0 22px; text-transform:uppercase; font-size:10px; letter-spacing:.18em; color:var(--muted); display:flex; align-items:center; gap:10px; }
.live-dot { width:6px; height:6px; border-radius:50%; background:var(--accent); box-shadow:0 0 0 0 rgba(255,91,58,.35); animation:ping 2.4s infinite; }
@keyframes ping { 60%{box-shadow:0 0 0 9px rgba(255,91,58,0)} 100%{box-shadow:0 0 0 0 rgba(255,91,58,0)} }
h1,h2,h3,p { text-wrap: balance; }
h1 { margin:0; font-size:clamp(68px,10.2vw,166px); letter-spacing:-.075em; line-height:.78; font-weight:720; max-width:1120px; position:relative; z-index:2; }
h1 em,h2 em { font-family: Georgia, "Times New Roman", serif; font-weight:400; letter-spacing:-.055em; }
.hero-copy { width:min(480px,44vw); margin:48px 0 18px 33.5%; font-size:clamp(16px,1.35vw,21px); line-height:1.55; color:var(--muted); position:relative; z-index:2; }
.text-link { width:max-content; margin-left:33.5%; text-decoration:none; font-size:12px; letter-spacing:.02em; display:inline-flex; gap:14px; border-bottom:1px solid var(--line-strong); padding:0 2px 7px; position:relative; z-index:2; transition:border-color .2s; }
.text-link span{transition:transform .25s var(--ease)} .text-link:hover span{transform:translate(3px,3px)}
.hero-footnote { position:absolute; bottom:27px; right:0; display:flex; gap:26px; font-size:9px; letter-spacing:.09em; text-transform:uppercase; color:var(--muted); }
.hero-footnote span{display:flex;align-items:center;gap:8px}.hero-footnote span::before{content:"";width:4px;height:4px;border-radius:50%;border:1px solid currentColor}
.hero-orbit { position:absol